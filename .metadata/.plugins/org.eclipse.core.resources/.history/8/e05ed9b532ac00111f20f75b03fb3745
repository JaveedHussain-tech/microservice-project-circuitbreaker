	  private final ObjectMapper objectMapper = new ObjectMapper();

	    @Override
	    public Exception decode(String methodKey, Response response) {

	    	HttpStatus status = HttpStatus.valueOf(response.status());

	        System.out.println("========== FEIGN ERROR ==========");
	        System.out.println("Method : " + methodKey);
	        System.out.println("Status : " + response.status());
	        System.out.println("Reason : " + response.reason());

	        if (response.body() == null) {

	            System.out.println("Employee service returned no error body");
	            System.out.println("=================================");
	            return new FeignClientException(
	                    "Employee service returned error: " + status,
	                    status
	            );
	        }

	        try (InputStream is = response.body().asInputStream()) {

	            ErrorResponse errorResponse =
	                    objectMapper.readValue(is, ErrorResponse.class);

	            System.out.println(
	                    "Employee error message : "
	                    + errorResponse.getMessage()
	            );
	            System.out.println("=================================");

	            return new FeignClientException(
	                    errorResponse.getMessage(),
	                    status
	            );

	        } catch (IOException e) {

	            System.out.println(
	                    "Could not read Employee service error response"
	            );

	            System.out.println("=================================");

	            return new FeignClientException(
	                    "Employee service returned error: " + status,
	                    status
	            );
	        }

	    }

}
