spring:
  application:
    name: API-Gateway

  cloud:
    gateway:
      server:
        webflux:
          routes:

            - id: EMPLOYEEMICROSERVICES
              uri: lb://EMPLOYEEMICROSERVICES
              predicates:
                - Path=/employees/**
              filters:
                - AuthFilter
                - name: CircuitBreaker
                  args:
                    name: EMPLOYEEMICROSERVICES
                    fallbackUri: forward:/employeeServiceFallback

            - id: ADDRESS
              uri: lb://ADDRESS
              predicates:
                - Path=/address/**
              filters:
                - AuthFilter
                - name: CircuitBreaker
                  args:
                    name: ADDRESS-SERVICE
                    fallbackUri: forward:/addressServiceFallback

            - id: AUTHORIZATION
              uri: lb://AUTHORIZATION
              predicates:
                - Path=/auth/**

server:
  port: 9090

eureka:
  instance:
    prefer-ip-address: true

  client:
    register-with-eureka: true
    fetch-registry: true
    serviceUrl:
      defaultZone: http://localhost:8761/eureka

